# ========================================================
# Military Asset Management System (MAMS)
# Environment Variables Configuration Template
# ========================================================

# Backend Database Configuration (MySQL 8)
DB_URL=jdbc:mysql://localhost:3306/mams_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_secure_mysql_password_here

# JWT Security Configuration
# 256-bit (32+ bytes) secret key for HMAC-SHA256 signing
JWT_SECRET=your_base64_or_hex_encoded_256_bit_jwt_secret_key_here
# Token expiration in milliseconds (e.g. 86400000 = 24 hours)
JWT_EXPIRATION=86400000

# Backend Server Port
SERVER_PORT=8080

# Frontend Configuration (Vite)
# Point to backend REST API (defaults to /api when using Vite dev proxy)
VITE_API_BASE_URL=/api
